</tr>
<tr>
<td><code>contentWidth</code></td>
<td>Base width used when scaling the injected website</td>
</tr>
<tr>
<td><code>windowWidth</code></td>
<td>Fake browser width</td>
</tr>
<tr>
<td><code>windowHeight</code></td>
